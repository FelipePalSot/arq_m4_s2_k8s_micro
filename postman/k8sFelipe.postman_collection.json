        {
          "name": "6. Micro Order - Crear Orden (FLUJO PRINCIPAL)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Guardar el ID de la orden creada para usarlo en los siguientes requests",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set('orderId', jsonData.id);",
                  "pm.environment.set('orderNumber', jsonData.orderNumber);",
                  "",
                  "// Validaciones del flujo",
                  "pm.test('Status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Tiene orderNumber generado', function () {",
                  "    pm.expect(jsonData.orderNumber).to.include('ORD-');",
                  "});",
                  "pm.test('Status es PENDING', function () {",
                  "    pm.expect(jsonData.status).to.equal('PENDING');",
                  "});",
                  "pm.test('totalAmount calculado correctamente', function () {",
                  "    pm.expect(jsonData.totalAmount).to.be.above(0);",
                  "});",
                  "pm.test('Items contienen info del producto', function () {",
                  "    pm.expect(jsonData.items[0].product).to.have.property('name');",
                  "    pm.expect(jsonData.items[0].unitPrice).to.be.above(0);",
                  "    pm.expect(jsonData.items[0].subtotal).to.be.above(0);",
                  "});",
                  "console.log('Orden creada: ' + jsonData.orderNumber + ' | Total: ' + jsonData.totalAmount);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 2\n    },\n    {\n      \"productId\": 3,\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "http://localhost:8084/api/orders",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8084",
              "path": ["api", "orders"]
            }
          },
          "response": []
